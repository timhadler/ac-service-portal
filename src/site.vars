# ══════════════════════════════════════════════════════════════
#  Site-wide values. Everything here is available to every page.
#  A key that is NOT defined renders as <span class="placeholder">[KEY]</span>,
#  which is how a to-be-confirmed value shows on the page today.
# ══════════════════════════════════════════════════════════════

site_url:      https://www.aircare.nz
og_image:      {{ site_url }}/images/og/og-default.jpg
phone:         0800 247 227
phone_href:    tel:0800247227
booking_url:   https://bookings.gettimely.com/AirCareHPC/bb/book
legal_name:    Speedy Little Cleaning Company Ltd

# Shared by the site-wide footer and the B2B trust bar, so it only needs
# updating in one place.
nzbn:          NZBN 9429049431803

wrapper_classes: site-wrapper
structured_data:

# The shared closing CTA (partials/cta-final.html). The slogan lives here
# and nowhere else on the site; a page may override either line.
cta_eyebrow:     Healthy heat pump, happy home.
cta_body:        We cover all of Christchurch and the surrounding areas. Online booking takes two minutes.


# ══════════════════════════════════════════════════════════════
#  Season, prices and conversion settings. The site's one source of
#  truth for all of them: every price below is written into the static
#  HTML at build time, so Google, link previews and no-JS visitors see it.
#
#  An empty value is "not set yet". It renders as nothing, never as a
#  visible [PLACEHOLDER], and a [key.none] group below supplies the
#  copy to use without it.
#
#  SWITCHING SEASON — see "Seasonal switching" in CLAUDE.md.
#    busy  (May–Sep): standard price, the busy why-now block.
#    quiet (Oct–Apr): off-peak rate, the quiet why-now block. Needs
#                     off_peak_price and off_peak_ends; the build fails
#                     without them, so a quiet season can never ship
#                     showing no price.
#  The Google Ads list prices, so change them the same day.
# ══════════════════════════════════════════════════════════════

season:               busy

# Deep Clean, per heat pump. The hero and both Deep Clean cards show
# whichever of these the season selects, as price_deep_clean.
standard_price:       109
off_peak_price:
off_peak_ends:        30 April

# "From May to September we're typically booked about N weeks ahead."
busy_lead_time_weeks: 3–4

# Every other displayed price. Numbers only; the page adds the "$".
price_deep_clean_additional:  99
price_deep_clean_plus:        139
price_mould_master:           189
price_duct_devil:             109
price_commercial_from:        129
price_hrv_filter:             179
price_hrv_additional:         109
price_dvs_filter:             119
price_dvs_additional:         99
price_better_vent_filter:     179
price_better_vent_additional: 109
price_smart_vent_filter:      199
price_emergency:              65

# Google Business Profile. Used by the trust bar, every rating line
# and every "Read all reviews on Google" link.
google_rating:        5.0
google_count_label:   40+
google_reviews_url:   https://search.google.com/local/reviews?placeid=ChIJ9-wXl9VKqUQROkkH3KQw9wE

# The customer-facing name of the indoor-coil flush. The home block,
# trust bar and Deep Clean cards all say "our {{ injection_name }}".
injection_name:       high-pressure injection system

# What Ros can reliably promise on a callback, as the end of the
# sentence "Ros will call you back ___."
callback_promise:     within 2 business days
callback_sentence:    Ros will call you back {{ callback_promise }}.

# The "Not sure which service you need?" callback box on services.
# May need turning off in the busy season if the phone is overloaded.
show_callback_box:    true

# Analytics. Empty = no tag is loaded and nothing is sent.
ga4_id:
ads_conversion_id:
ads_conversion_label:

# The lead-time sentences, each carrying its own joining whitespace so
# that the [busy_lead_time_weeks.none] fallback (at the end of this file)
# can drop them without leaving a gap.
why_now_busy_lead: <<
From May to September we&rsquo;re typically booked about {{ busy_lead_time_weeks }} weeks ahead.

<<
why_now_quiet_lead: <<

From May we&rsquo;re typically booked about {{ busy_lead_time_weeks }} weeks ahead.
<<


response_time:   2 working days

# ── Values still to be confirmed. Uncomment and fill; every page that
#    uses one follows, and the grey [PLACEHOLDER] styling goes with it.
# min_units:      4
# min_price:      $340 + GST
# sitewise:       SiteWise Green


# ══════════════════════════════════════════════════════════════
#  Nav variants. One partials/header.html, three sets of values.
#
#  The B2B groups diverge from the consumer nav in two deliberate ways:
#
#   1. The orange "Book Now" item is replaced by the phone. These buyers
#      decide on the call, and online booking is wrong for a site that
#      needs quoting.
#   2. nav.commercial carries NO property managers link. A business owner
#      who follows it is a lost lead mid-consideration. nav.property does
#      keep it, since that page set is aimed at managers.
#
#  nav_pm_item carries its OWN leading newline so that an empty value
#  leaves no blank line behind — it is appended to the end of the
#  Services item rather than sitting on a line of its own.
# ══════════════════════════════════════════════════════════════

[nav.commercial]
wrapper_classes: site-wrapper has-sticky-cta
footer_pm_item:
nav_pm_item:
nav_pm_item_m:
nav_cta_desktop: <<
                <a href="tel:0800247227" class="nav__phone" data-track="phone-commercial">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2.5 2h2.5l1.25 2.75-1.25.875A7.5 7.5 0 008.375 9l.875-1.25L12 9V11.5A1 1 0 0111 12.5C5.2 12.5 1.5 8.8 1.5 3A1 1 0 012.5 2z" fill="currentColor"/>
                    </svg>
                    0800 247 227
                </a>
<<
nav_cta_mobile: <<
                <a href="tel:0800247227" data-track="phone-commercial">Call us — 0800 247 227</a>
<<

[nav.consumer]
footer_pm_item: <<

                    <li><a href="property-managers.html">Property Managers</a></li>
<<
nav_pm_item: <<

                <li><a href="property-managers.html">Property managers</a></li>
<<
nav_pm_item_m: <<

            <li><a href="property-managers.html">Property managers</a></li>
<<
nav_cta_desktop: <<
                <a href="{{ booking_url }}"
                    class="nav__book" target="_blank" rel="noopener">
                    Book Now
                </a>
<<
nav_cta_mobile: <<
                <a href="{{ booking_url }}"
                target="_blank" rel="noopener">Book Now</a>
<<


# ══════════════════════════════════════════════════════════════
#  Structured data. A page opts in with `use:`; pages that do not
#  fall back to the empty default above.
#
#  crumb_plain is the breadcrumb name inside JSON — plain text, so
#  it uses "&" where the page's visible eyebrow uses "&amp;".
# ══════════════════════════════════════════════════════════════

[schema.breadcrumb]
structured_data: <<


  <!-- The hub -> vertical hierarchy, declared for search results. The flat
       filenames do not express it; this does, which is what shows a
       breadcrumb trail in a SERP. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",
        "item": "{{ site_url }}/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial",
        "item": "{{ site_url }}/commercial" },
      { "@type": "ListItem", "position": 3, "name": "{{ crumb_plain }}",
        "item": "{{ canonical }}" }
    ]
  }
  </script>

<<

[schema.breadcrumb-hub]
structured_data: <<


  <!-- The hub -> vertical hierarchy, declared for search results. The flat
       filenames do not express it; this does, which is what shows a
       breadcrumb trail in a SERP. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",
        "item": "{{ site_url }}/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial",
        "item": "{{ canonical }}" }
    ]
  }
  </script>

<<

[nav.property]
wrapper_classes: site-wrapper has-sticky-cta
footer_pm_item: <<

                    <li><a href="property-managers.html">Property Managers</a></li>
<<
nav_pm_item: <<

                <li><a href="property-managers.html">Property managers</a></li>
<<
nav_pm_item_m: <<

            <li><a href="property-managers.html">Property managers</a></li>
<<
nav_cta_desktop: <<
                <!-- TODO: swap to Ros's direct line once confirmed -->
                <a href="tel:0800247227" class="nav__phone">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2.5 2h2.5l1.25 2.75-1.25.875A7.5 7.5 0 008.375 9l.875-1.25L12 9V11.5A1 1 0 0111 12.5C5.2 12.5 1.5 8.8 1.5 3A1 1 0 012.5 2z" fill="currentColor"/>
                    </svg>
                    0800 247 227
                </a>
<<
nav_cta_mobile: <<
                <!-- TODO: swap to Ros's direct line once confirmed -->
                <a href="tel:0800247227">Call us — 0800 247 227</a>
<<


# ══════════════════════════════════════════════════════════════
#  Trust bar labels. Same markup on every page that shows it
#  (src/partials/trust-bar.html); only these four lines differ.
#
#  A homeowner and a property manager are buying on different
#  things, so the two sets are deliberately not the same claims.
# ══════════════════════════════════════════════════════════════

[trust.consumer]
trust_item_1: <a href="{{ google_reviews_url }}" target="_blank" rel="noopener">&#9733; {{ google_rating }} &middot; {{ google_count_label }} Google reviews<span class="sr-only"> (opens in a new tab)</span></a>
trust_item_2: <a href="#injection">Coils flushed with our {{ injection_name }}</a>
trust_item_3: Local family business
trust_item_4: Christchurch &amp; North Canterbury

[trust.b2b]
trust_item_1: Over 5 years trading
trust_item_2: Public liability insured
trust_item_3: {{ nzbn }}
trust_item_4: 3 technicians, 4 vehicles


# ══════════════════════════════════════════════════════════════
#  Switch groups. Unlike the groups above, no page names these in
#  `use:` — each applies to every page when the site-level value
#  before the dot matches the part after it. [key.none] matches an
#  empty value. See the docstring at the top of tools/build.py.
# ══════════════════════════════════════════════════════════════

[season.busy]
price_deep_clean:  {{ standard_price }}
why_now_eyebrow:   Winter is our busy season
why_now_heading:   Book early to get the time you want
why_now_body:      {{ why_now_busy_lead }}Online booking shows every open slot, so it&rsquo;s the quickest way to lock one in.

[season.quiet]
require:           off_peak_price, off_peak_ends
price_deep_clean:  {{ off_peak_price }}
why_now_eyebrow:   Off-peak rate
why_now_heading:   ${{ off_peak_price }} per heat pump until {{ off_peak_ends }}
why_now_body:      October to April is our quiet season, so there&rsquo;s more availability and a lower rate.{{ why_now_quiet_lead }}

# Without a lead time, the sentence that quotes one is dropped.
[busy_lead_time_weeks.none]
why_now_busy_lead:
why_now_quiet_lead:

[callback_promise.none]
callback_sentence: Ros will call you back.

[show_callback_box.true]
callback_hidden:

[show_callback_box.false]
callback_hidden:   hidden
