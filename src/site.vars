# ══════════════════════════════════════════════════════════════
#  Site-wide values. Everything here is available to every page.
#  A key that is NOT defined renders as <span class="placeholder">[KEY]</span>,
#  which is how a to-be-confirmed value shows on the page today.
# ══════════════════════════════════════════════════════════════

site_url:      https://www.aircare.nz
og_image:      {{ site_url }}/images/og/og-default.jpg
phone:         0800 247 227
phone_href:    tel:0800247227
booking_url:   https://bookings.gettimely.com/AirCareHPC/bb/book
legal_name:    Speedy Little Cleaning Company Ltd

# Shared by the site-wide footer and the B2B trust bar, so it only needs
# updating in one place.
nzbn:          NZBN 9429049431803

wrapper_classes: site-wrapper
structured_data:

response_time:   2 working days

# ── Values still to be confirmed. Uncomment and fill; every page that
#    uses one follows, and the grey [PLACEHOLDER] styling goes with it.
# min_units:      4
# min_price:      $340 + GST
# sitewise:       SiteWise Green


# ══════════════════════════════════════════════════════════════
#  Nav variants. One partials/header.html, three sets of values.
#
#  The B2B groups diverge from the consumer nav in two deliberate ways:
#
#   1. The orange "Book Now" item is replaced by the phone. These buyers
#      decide on the call, and online booking is wrong for a site that
#      needs quoting.
#   2. nav.commercial carries NO property managers link. A business owner
#      who follows it is a lost lead mid-consideration. nav.property does
#      keep it, since that page set is aimed at managers.
#
#  nav_pm_item carries its OWN leading newline so that an empty value
#  leaves no blank line behind — it is appended to the end of the
#  Services item rather than sitting on a line of its own.
# ══════════════════════════════════════════════════════════════

[nav.commercial]
wrapper_classes: site-wrapper has-sticky-cta
footer_pm_item:
nav_pm_item:
nav_pm_item_m:
nav_cta_desktop: <<
                <a href="tel:0800247227" class="nav__phone" data-track="phone-commercial">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2.5 2h2.5l1.25 2.75-1.25.875A7.5 7.5 0 008.375 9l.875-1.25L12 9V11.5A1 1 0 0111 12.5C5.2 12.5 1.5 8.8 1.5 3A1 1 0 012.5 2z" fill="currentColor"/>
                    </svg>
                    0800 247 227
                </a>
<<
nav_cta_mobile: <<
                <a href="tel:0800247227" data-track="phone-commercial">Call us — 0800 247 227</a>
<<

[nav.consumer]
footer_pm_item: <<

                    <li><a href="property-managers.html">Property Managers</a></li>
<<
nav_pm_item: <<

                <li><a href="property-managers.html">Property managers</a></li>
<<
nav_pm_item_m: <<

            <li><a href="property-managers.html">Property managers</a></li>
<<
nav_cta_desktop: <<
                <a href="{{ booking_url }}"
                    class="nav__book" target="_blank" rel="noopener">
                    Book Now
                </a>
<<
nav_cta_mobile: <<
                <a href="{{ booking_url }}"
                target="_blank" rel="noopener">Book Now</a>
<<


# ══════════════════════════════════════════════════════════════
#  Structured data. A page opts in with `use:`; pages that do not
#  fall back to the empty default above.
#
#  crumb_plain is the breadcrumb name inside JSON — plain text, so
#  it uses "&" where the page's visible eyebrow uses "&amp;".
# ══════════════════════════════════════════════════════════════

[schema.breadcrumb]
structured_data: <<


  <!-- The hub -> vertical hierarchy, declared for search results. The flat
       filenames do not express it; this does, which is what shows a
       breadcrumb trail in a SERP. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",
        "item": "{{ site_url }}/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial",
        "item": "{{ site_url }}/commercial" },
      { "@type": "ListItem", "position": 3, "name": "{{ crumb_plain }}",
        "item": "{{ canonical }}" }
    ]
  }
  </script>

<<

[schema.breadcrumb-hub]
structured_data: <<


  <!-- The hub -> vertical hierarchy, declared for search results. The flat
       filenames do not express it; this does, which is what shows a
       breadcrumb trail in a SERP. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",
        "item": "{{ site_url }}/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial",
        "item": "{{ canonical }}" }
    ]
  }
  </script>

<<

[nav.property]
wrapper_classes: site-wrapper has-sticky-cta
footer_pm_item: <<

                    <li><a href="property-managers.html">Property Managers</a></li>
<<
nav_pm_item: <<

                <li><a href="property-managers.html">Property managers</a></li>
<<
nav_pm_item_m: <<

            <li><a href="property-managers.html">Property managers</a></li>
<<
nav_cta_desktop: <<
                <!-- TODO: swap to Ros's direct line once confirmed -->
                <a href="tel:0800247227" class="nav__phone">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2.5 2h2.5l1.25 2.75-1.25.875A7.5 7.5 0 008.375 9l.875-1.25L12 9V11.5A1 1 0 0111 12.5C5.2 12.5 1.5 8.8 1.5 3A1 1 0 012.5 2z" fill="currentColor"/>
                    </svg>
                    0800 247 227
                </a>
<<
nav_cta_mobile: <<
                <!-- TODO: swap to Ros's direct line once confirmed -->
                <a href="tel:0800247227">Call us — 0800 247 227</a>
<<


# ══════════════════════════════════════════════════════════════
#  Trust bar labels. Same markup on every page that shows it
#  (src/partials/trust-bar.html); only these four lines differ.
#
#  A homeowner and a property manager are buying on different
#  things, so the two sets are deliberately not the same claims.
# ══════════════════════════════════════════════════════════════

[trust.consumer]
trust_item_1: Local Kiwi Family
trust_item_2: Thorough Clean, Every Time
trust_item_3: Transparent, Competitive Pricing
trust_item_4: 5-star Average Google Reviews

[trust.b2b]
trust_item_1: Over 5 years trading
trust_item_2: Public liability insured
trust_item_3: {{ nzbn }}
trust_item_4: 3 technicians, 4 vehicles
